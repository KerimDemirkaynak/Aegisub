i18n = import('i18n')
# This should only be used to compile the translations during a build.
# Meson's i18n module is not sufficient to generate a pot file:
# It misses translatable strings not directly found in either
# C++ source, desktop or appdata file. This affects strings
# of the Windows installer (iss), from Lua scripts and JSON files.
# Until a solution is found, POT updates should continue to use make_pot.sh.
# Similarly, since meson insists on regenerating the POT file before updating
# PO files, PO files should be updated using update_po.sh
i18n.gettext('aegisub',
             args: [
                '-k_', '-kSTR_MENU', '-kSTR_DISP', '-kSTR_HELP', '-kCOMMAND_GROUP:5,',
                '-kfmt_tl', '-kfmt_plural:2,3',
                '--sort-by-file'
             ],
             install_dir: localedir)

# Translation statistics target.
# Shows translated/untranslated/fuzzy counts for all languages.
# Run with: ninja -C <builddir> po-stats
# Requires 'sh' and 'msgfmt' (gettext tools). Not available on Windows without Git Bash/WSL.
sh = find_program('sh', required: false)
if sh.found()
    run_target('po-stats',
               command: [sh, files('stats.sh')],
               depends: [])
endif

# wxWidgets internal translation files (wxstd.mo).
#
# These are needed so that wxWidgets-provided strings (e.g. predefined button
# labels, the "&Help" menu entry) are properly translated in the UI. wxWidgets
# loads these via translations->AddStdCatalog() in aegisublocale.cpp, searching
# in the same locale directory as aegisub.mo.
#
# xref: https://github.com/TypesettingTools/Aegisub/issues/379
#
# Source priority (first found wins):
#   1. subprojects/wxWidgets/locale/*.po  — available when using the wx wrap
#      (most reliable: always matches the exact wx version being compiled)
#   2. src/mo/wxstd-*.mo  — pre-compiled by tools/fetch_wxstd.sh / fetch_wxstd.ps1
#      (fallback for system wx builds or when the subproject dir is absent)
#
# Mapping: Aegisub locale name -> wxWidgets .po filename stem
fs = import('fs')

msgfmt = find_program('msgfmt', required: false)

wxstd_locales = {
    'ar':     'ar',
    'ca':     'ca',
    'cs':     'cs',
    'da':     'da',
    'de':     'de',
    'el':     'el',
    'es':     'es',
    'eu':     'eu',
    'fa':     'fa_IR',
    'fi':     'fi',
    'fr_FR':  'fr',
    'gl':     'gl_ES',
    'hu':     'hu',
    'id':     'id',
    'it':     'it',
    'ja':     'ja',
    'ko':     'ko_KR',
    'lt':     'lt',
    'nl':     'nl',
    'pl':     'pl',
    'pt_BR':  'pt_BR',
    'pt_PT':  'pt',
    'ru':     'ru',
    'sr_RS':  'sr',
    'tr':     'tr',
    'uk_UA':  'uk',
    'vi':     'vi',
    'zh_CN':  'zh_CN',
    'zh_TW':  'zh_TW',
}

# Path to the wxWidgets locale sources inside the subproject clone
wx_locale_src = meson.project_source_root() / 'subprojects' / 'wxWidgets' / 'locale'

foreach aegi_lang, wx_lang : wxstd_locales
    wx_po = wx_locale_src / wx_lang + '.po'
    prebuilt_mo = meson.project_source_root() / 'src' / 'mo' / 'wxstd-' + aegi_lang + '.mo'

    if msgfmt.found() and fs.exists(wx_po)
        # Best case: compile directly from the wxWidgets subproject sources.
        # This is distribution-agnostic and always matches the linked wx version.
        #
        # Use unique output filenames (wxstd-{lang}.mo) to avoid collisions between
        # the targets defined in this foreach loop. Then install via install_data
        # with rename:'wxstd.mo', which is supported since Meson 0.46.0.
        # (install_rename on custom_target requires Meson >= 0.64.0 and is avoided.)
        mo = custom_target('wxstd-' + aegi_lang,
            input:            wx_po,
            output:           'wxstd-' + aegi_lang + '.mo',
            command:          [msgfmt, '-o', '@OUTPUT@', '@INPUT@'],
            build_by_default: false,
        )
        install_data(mo,
                     install_dir: localedir / aegi_lang / 'LC_MESSAGES',
                     rename: 'wxstd.mo')
    elif fs.exists(prebuilt_mo)
        # Fallback: use pre-compiled .mo from src/mo/.
        # Generated by tools/fetch_wxstd.sh (macOS/Linux) or fetch_wxstd.ps1 (Windows).
        install_data(prebuilt_mo,
                     install_dir: localedir / aegi_lang / 'LC_MESSAGES',
                     rename: 'wxstd.mo')
    endif
endforeach
